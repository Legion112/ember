bin/
coverage.out
coverage.html

.idea/
.vscode/

# ember.yaml is committed as an example; the operator's real config and every
# secret live outside the repo. See AGENTS.md: a credential in git history is
# not revocable by deleting the file.
credentials.yaml
*.pem
*.key
id_ed25519*
.model.gguf

# Claude Code's per-project permission rules. Local and not committed: they
# say what this machine lets an agent do to this repository's issues and pull
# requests under the operator's own GitHub account, which is a property of the
# machine and the account rather than of the code. A committed copy would hand
# the same grants to anybody who clones and runs an agent here.
.claude/settings.local.json

# The built web UI. `make web` writes these into internal/webapi/dist beside
# the committed placeholder index.html, which exists because //go:embed fails
# at compile time on a pattern that matches nothing -- so `go build ./...`
# must work on a clean clone with no Rust installed.
#
# The artefacts themselves are not committed: a wasm blob changes on every
# build and nobody can review one.
internal/webapi/dist/ember.js
internal/webapi/dist/ember_bg.wasm
internal/webapi/dist/ember.d.ts
internal/webapi/dist/style.css
web/target/
